{
  "name": "react-native-spritestudio",
  "version": "7.0.0-beta.1",
  "description": "SpriteStudio 7 animation player for React Native (New Architecture / Nitro + Skia)",
  "license": "BSD-3-Clause",
  "main": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src",
    "lib",
    "bin",
    "cpp",
    "nitrogen",
    "plugin",
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/src",
    "third_party/flatbuffers/include",
    "native/libs",
    "native/include",
    "native/VERSION",
    "native/BUILD_MODE",
    "native/LICENSE.md",
    "native/THIRD-PARTY-LICENSES.ssruntime.md",
    "app.plugin.js",
    "*.podspec",
    "nitro.json"
  ],
  "scripts": {
    "nitrogen": "nitrogen",
    "typecheck": "tsc --noEmit",
    "prepack": "bob build && node scripts/prepack.mjs",
    "build": "bob build"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "^2.11.0",
    "react": "^19.2.8",
    "react-native": "^0.87.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "^4.5.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "nitrogen": "^0.37.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.37.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForReactNative.git"
  },
  "keywords": [
    "react-native",
    "spritestudio",
    "animation",
    "skia",
    "nitro"
  ],
  "bin": {
    "react-native-spritestudio": "./bin/spritestudio.js"
  },
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "//browser": "Not web support — the stub barrel, so an app that ships web as well as native can still build its web bundle (src/index.web.ts). Points at source for the same reason `react-native` does; it moves to lib/ with `main` when the npm-publishing item in ROADMAP.md lands.",
  "browser": "src/index.web.ts",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
